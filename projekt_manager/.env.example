# Skopíruj tento súbor ako .env a uprav hodnoty.

# Náhodný tajný kľúč – vygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=zmen-ma-na-nahodny-retazec

APP_NAME=Prehľad projektov
# Adresa, na ktorej je aplikácia dostupná (odkazy v e-mailoch)
APP_URL=http://localhost:8000
# Port na hostiteľovi pri behu v Dockeri (docker-compose.yml)
APP_PORT=8000

# Kde sa ukladá databáza a dokumenty (predvolene ./data)
# DATA_DIR=/srv/projekty/data
MAX_UPLOAD_MB=50

# ---------- E-mail (SMTP) ----------
MAIL_ENABLED=false
# Gmail:       smtp.gmail.com, 587, TLS=true  (heslo = "heslo aplikácie", nie bežné heslo)
# Microsoft365: smtp.office365.com, 587, TLS=true
# Port 465:    MAIL_USE_SSL=true, MAIL_USE_TLS=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=tvoj.ucet@gmail.com
MAIL_PASSWORD=heslo-aplikacie
MAIL_SENDER=tvoj.ucet@gmail.com

# ---------- Denný report ----------
SCHEDULER_ENABLED=true
DAILY_REPORT_TIME=07:30
DAILY_REPORT_SKIP_WEEKEND=true
# Koľko dní pred deadlinom sa projekt označí ako „blíži sa termín“
DUE_SOON_DAYS=7

# true, ak aplikácia beží cez HTTPS
SESSION_COOKIE_SECURE=false
