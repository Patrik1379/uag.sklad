# Skopírujte tento súbor ako .env a upravte hodnoty

# --- Základ -------------------------------------------------------------------
PORT=8000
# heslo databázy – používajte iba písmená a číslice
DB_PASSWORD=silneHesloDatabazy123
# dlhý náhodný reťazec (na serveri vygenerujete:  openssl rand -hex 32)
SECRET_KEY=nahodny-dlhy-retazec-napr-64-znakov
# Prvý administrátor – vytvorí sa iba pri prvom spustení (prázdna databáza)
ADMIN_USER=admin
ADMIN_PASSWORD=admin
# počet procesov aplikácie (pri 1 GB RAM dajte 2)
WORKERS=3

# --- Len pre server na internete (pozri NASADENIE.md) -------------------------
# doména, na ktorej aplikácia pobeží; bez vlastnej domény použite IP s pomlčkami + .sslip.io,
# napr. pre IP 185.8.1.2 ->  185-8-1-2.sslip.io
#DOMAIN=sklad.vasafirma.sk
# aplikácia bude dostupná iba cez HTTPS (Caddy), nie priamo na porte 8000
#BIND=127.0.0.1
#BEHIND_PROXY=1
#COOKIE_SECURE=1
